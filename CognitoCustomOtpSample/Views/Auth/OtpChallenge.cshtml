@model OtpChallengeViewModel
@{
    ViewData["Title"] = "ワンタイムパスワード認証";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">ワンタイムパスワード認証</h2>

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info">@TempData["InfoMessage"]</div>
                }

                <div class="alert alert-info">
                    <p class="mb-0">
                        <strong>@Model.Email</strong> 宛にワンタイムパスワードを送信しました。<br />
                        メールに記載されている6桁のコードを入力してください。
                    </p>
                </div>

                <form asp-action="OtpChallenge" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Session" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label">ワンタイムパスワード（6桁）</label>
                        <input asp-for="OtpCode" class="form-control form-control-lg text-center"
                               maxlength="6" placeholder="000000" autocomplete="off" />
                        <span asp-validation-for="OtpCode" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">認証</button>
                        <a asp-action="SignIn" class="btn btn-outline-secondary">キャンセル</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
