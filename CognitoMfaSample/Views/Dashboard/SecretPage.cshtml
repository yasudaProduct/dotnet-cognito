@{
    ViewData["Title"] = "秘密のページ";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">秘密のページ</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <h5>おめでとうございます！</h5>
                    <p class="mb-0">このページはログインユーザーのみがアクセスできる秘密のページです。</p>
                </div>

                <h5>会員限定コンテンツ</h5>
                <p>
                    このサンプルでは、Form認証（EntityFramework InMemory）とAmazon Cognitoの多要素認証（Email-OTP）を組み合わせています。
                </p>

                <h5 class="mt-4">実装のポイント</h5>
                <ul>
                    <li>EntityFramework InMemoryでユーザー管理・パスワード認証</li>
                    <li>Amazon Cognitoで多要素認証（Email-OTP）</li>
                    <li>Cookie認証でセッション管理</li>
                    <li>カスタム認証フィルター (<code>[AuthRequired]</code>) でアクセス制御</li>
                </ul>

                <hr />

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-primary">ダッシュボードに戻る</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">トップページへ</a>
                </div>
            </div>
        </div>
    </div>
</div>
