@{
    ViewData["Title"] = "ホーム";
}

<div class="text-center">
    <h1 class="display-4">Form認証 + Cognito MFA サンプル</h1>
    <p class="lead">EntityFramework InMemoryによるForm認証とAmazon Cognito Email-OTPによる多要素認証のデモアプリケーションです。</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Form認証</h5>
                <p class="card-text">EntityFramework InMemoryでユーザー管理。メールアドレスとパスワードで認証します。</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Cognito MFA</h5>
                <p class="card-text">Amazon Cognitoで多要素認証（Email-OTP）を提供。ログイン時にメールでワンタイムパスワードが送信されます。</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Cookie認証</h5>
                <p class="card-text">ASP.NET CoreのCookie認証でセッション管理。24時間有効です。</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 justify-content-center">
    <div class="col-md-8">
        <div class="card bg-light">
            <div class="card-body text-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <h5>ログイン中です</h5>
                    <p>ダッシュボードで会員限定コンテンツをご覧いただけます。</p>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg">ダッシュボードへ</a>
                }
                else
                {
                    <h5>ログインして会員限定コンテンツにアクセス</h5>
                    <p>アカウントをお持ちでない方は、まずサインアップしてください。</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Auth" asp-action="SignIn" class="btn btn-primary btn-lg">ログイン</a>
                        <a asp-controller="Auth" asp-action="SignUp" class="btn btn-outline-primary btn-lg">サインアップ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-12">
        <h4>このサンプルについて</h4>
        <p>
            このアプリケーションは、.NET 8とAmazon Cognitoを使用した認証システムのサンプル実装です。
            通常の認証（Form認証）はEntityFramework InMemoryで管理し、多要素認証（MFA）のみAmazon Cognitoを使用しています。
        </p>
        <ul>
            <li>ユーザー登録（サインアップ）- EFとCognito両方にユーザー作成</li>
            <li>メールアドレス確認（Cognito）</li>
            <li>ユーザーログイン（サインイン）- EFで認証後、CognitoでMFA</li>
            <li>メールによるワンタイムパスワード（Email-OTP）認証</li>
            <li>ログイン必須ページへのアクセス制御</li>
            <li>Cookie認証によるセッション管理</li>
        </ul>
    </div>
</div>
