@model CognitoEmailOtpSample.Models.SignInViewModel
@{
    ViewData["Title"] = "サインイン";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h2 class="text-center mb-4">サインイン</h2>

        <div class="card">
            <div class="card-body">
                <form asp-action="SignIn" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">メールアドレス</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">パスワード</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="パスワードを入力" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">次へ（OTP送信）</button>
                    </div>
                </form>

                <div class="mt-4">
                    <h6>テストユーザー:</h6>
                    <ul class="small">
                        <li>user@example.com / Password123!</li>
                        <li>test@example.com / Test123!</li>
                    </ul>
                    <p class="small text-muted">
                        ※ Cognitoにも同じメールアドレスのユーザーが存在している必要があります
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
