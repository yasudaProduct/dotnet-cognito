@{
    ViewData["Title"] = "ダッシュボード";
    var userName = ViewData["UserName"]?.ToString() ?? "Guest";
}

<div class="row">
    <div class="col-12">
        <h2>ダッシュボード</h2>
        <hr />

        <div class="alert alert-success">
            <h4>認証成功</h4>
            <p>ようこそ、<strong>@userName</strong> さん</p>
            <p class="mb-0">独自パスワード認証とCognito Email OTPの両方の検証に成功しました。</p>
        </div>

        <div class="card">
            <div class="card-header">
                <h5>認証フロー</h5>
            </div>
            <div class="card-body">
                <ol>
                    <li>
                        <strong>ローカル認証（独自パスワード）</strong>
                        <p class="text-muted">アプリケーション内でメールアドレスとパスワードを検証</p>
                    </li>
                    <li>
                        <strong>Cognito Email OTP チャレンジ開始</strong>
                        <p class="text-muted">InitiateAuth API (AuthFlow=USER_AUTH, PREFERRED_CHALLENGE=EMAIL_OTP)</p>
                    </li>
                    <li>
                        <strong>Email OTP コード検証</strong>
                        <p class="text-muted">RespondToAuthChallenge API (ChallengeName=EMAIL_OTP)</p>
                    </li>
                    <li>
                        <strong>Cookie 認証でサインイン</strong>
                        <p class="text-muted">アプリケーションのログイン状態をCookieで保持</p>
                    </li>
                </ol>
            </div>
        </div>

        <div class="mt-3">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger">サインアウト</button>
            </form>
        </div>
    </div>
</div>
